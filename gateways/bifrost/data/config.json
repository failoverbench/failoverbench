{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": { "drop_excess_requests": false, "enable_logging": true },
  "providers": {
    "fake": {
      "keys": [{ "name": "fake-key", "value": "failoverbench", "models": ["*"], "weight": 1.0 }],
      "network_config": {
        "base_url": "http://host.docker.internal:8401",
        "allow_private_network": true,
        "default_request_timeout_in_seconds": 30,
        "stream_idle_timeout_in_seconds": 30,
        "max_retries": 2,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 5000
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": { "list_models": true, "chat_completion": true, "chat_completion_stream": true }
      }
    }
  },
  "config_store": { "enabled": false }
}
